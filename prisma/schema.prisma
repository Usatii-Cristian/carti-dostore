generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Book {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String   @unique
  author         String
  description    String
  price          Float
  discountPrice  Float?
  coverImage     String
  images         String[]
  categoryId     String   @db.ObjectId
  category       Category @relation(fields: [categoryId], references: [id])
  publisher      String?
  isbn           String?
  language       String   @default("Română")
  pageCount      Int?
  // Greutatea la ambalare, în grame. FAN Courier tarifează pe kg, deci fără ea
  // nu putem calcula corect costul livrării. Opțional: produsele fără greutate
  // intră în calcul cu estimarea implicită din lib/shipping/weight.ts.
  weightGrams    Int?
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  isBestseller   Boolean  @default(false)
  // Poziția în secțiunea Bestsellers (0 = prima). Ordonarea după `rating` nu
  // era suficientă: produsele cu rating egal ieșeau în ordine arbitrară.
  bestsellerOrder Int     @default(0)
  // Poziția în catalog, la sortarea implicită (0 = prima). Permite aranjarea
  // manuală a produselor dintr-o categorie, independent de data adăugării.
  displayOrder    Int     @default(0)
  isNew          Boolean  @default(false)
  tags           String[]
  // Întrebări frecvente specifice produsului, administrate din panoul de admin.
  // Embedded (nu model separat): aparțin exclusiv produsului, se citesc mereu
  // împreună cu el și se rescriu în bloc la salvare.
  faqs           BookFaq[]
  // Recenzii, administrate din admin. `rating` și `reviewCount` de mai sus se
  // recalculează automat din ele la salvare.
  reviews        BookReview[]
  // Specificații libere (etichetă + valoare), administrate din admin și afișate
  // ca badge-uri pe pagina produsului. Ex: „Vârstă"→„12+", „Pagini"→„300".
  specs          BookSpec[]
  // Tipurile în care se vinde produsul (ex. cele 14 tipuri de etichete). Gol =
  // produs fără variante, se adaugă direct în coș.
  variants       BookVariant[]
  searchText     String
  orderItems     OrderItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([categoryId])
}

model Category {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String @unique
  slug  String @unique
  icon  String?
  // Imagine proprie, încărcată din admin. Când există, înlocuiește iconița
  // în listele de categorii de pe site.
  image String?
  // Ce apare în secțiunea „Categorii populare" de pe pagina principală și în
  // ce ordine — controlat din admin, nu din cod.
  featured      Boolean @default(false)
  featuredOrder Int     @default(0)
  books Book[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE            // plată pe site prin QR (VictoriaBank MIA)
  CARD_ON_DELIVERY  // card la livrare
  CASH_ON_DELIVERY  // numerar la livrare
}

model Order {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber       String             @unique
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   String
  // Detaliile de acces, cerute separat în checkout: fără ele curierul sună
  // clientul ca să afle la ce bloc/apartament vine. Se lipesc și în adresa
  // trimisă la FAN, ca să apară pe AWB.
  building          String?            // bloc / casă (ex. „bl. 3" sau „casă")
  apartment         String?            // apartament / oficiu
  // Mesaj opțional de la client pentru curier („sunați înainte", cod interfon).
  customerNote      String?
  city              String
  // Raionul (province la FAN). Obligatoriu pentru AWB — se completează automat
  // din localitatea aleasă în checkout, fiindcă lista FAN dă perechea oraș+raion.
  county            String?
  items             OrderItem[]
  subtotal          Float
  shippingCost      Float
  total             Float
  status            OrderStatus        @default(PENDING)
  // Cum alege clientul să plătească: ONLINE (QR pe site), CARD_ON_DELIVERY
  // (card la livrare) sau CASH_ON_DELIVERY (numerar la livrare).
  paymentMethod     PaymentMethod      @default(ONLINE)
  paymentStatus     PaymentStatus      @default(UNPAID)
  paymentId         String?
  // Momentul în care banii au intrat efectiv: la confirmarea plății online sau,
  // la plata la livrare, când comanda e marcată livrată în admin. Până acum
  // singurul reper era `updatedAt`, care se schimbă la orice modificare.
  paidAt            DateTime?
  // Plată VictoriaBank MIA (QR). Le păstrăm ca să interogăm statusul la bancă
  // și să potrivim semnalele (webhook) cu comanda.
  qrHeaderUUID      String?
  qrExtensionUUID   String?
  qrPayUrl          String?            // payload-ul QR (link), din care regenerăm imaginea
  // Momentul în care clientul a bifat acordul cu termenii, politica de
  // confidențialitate și cea de retur. Păstrat ca dovadă a consimțământului.
  termsAcceptedAt   DateTime?
  // Tracking livrare
  trackingNumber    String?            // AWB de la curier (FANcourier)
  estimatedDelivery DateTime?          // termen estimat de livrare
  // Cât ne costă PE NOI expedierea, după tariful din contractul FAN. Nu e ce
  // plătește clientul (acela vine din regula proprie) — se salvează ca să se
  // vadă marja reală pe fiecare comandă în admin.
  fanCost           Float?
  statusHistory     OrderStatusEvent[] // istoricul stadiilor, cu timestamp
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// Contor pentru limitarea trimiterilor din formularele publice (deocamdată
// recenziile). Stă în baza de date, nu într-un Map în memorie: pe Vercel fiecare
// instanță de funcție are propria memorie și se reciclează, deci un contor local
// nu ar limita nimic real. Cheia e hash-uită (IP + scop), nu ținem IP-uri brute.
model RateLimit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// Un tip/variantă a produsului (ex. „Suplimente", „Limba italiană"), embedded.
// Multe produse din catalog există în mai multe variante — etichetele au 14
// tipuri, cărțile pot fi în 3 limbi — iar clientul trebuie să poată alege
// exact ce vrea, câte bucăți din fiecare.
type BookVariant {
  label String
  // Preț propriu, dacă varianta costă altfel decât produsul de bază.
  price Float?
}

// O specificație a produsului (etichetă + valoare), embedded.
type BookSpec {
  label String // ex: „Vârstă", „Pagini", „Categorie"
  value String // ex: „12+", „300", „Dezvoltare personală"
}

// O recenzie a unui produs (embedded).
type BookReview {
  author String
  rating Int      // 1–5 stele
  text   String
  date   DateTime @default(now())
}

// O întrebare frecventă atașată unui produs.
type BookFaq {
  question    String
  answer      String
  // Dacă e true, acordeonul apare deja deschis la încărcarea paginii.
  defaultOpen Boolean @default(false)
}

// Un stadiu din istoricul comenzii (embedded), pentru timeline-ul de tracking.
type OrderStatusEvent {
  status OrderStatus
  at     DateTime
}

model OrderItem {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  orderId  String @db.ObjectId
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId   String @db.ObjectId
  book     Book   @relation(fields: [bookId], references: [id])
  title    String
  price    Float
  quantity Int

  @@index([orderId])
  @@index([bookId])
}

model Publisher {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  slug String @unique
}

model Admin {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  password String
}

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  createdAt DateTime @default(now())
}

// Articol de blog, administrat complet din panoul de admin.
model BlogPost {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  excerpt     String    // rezumatul din listă și din meta description
  content     String    // corpul articolului, în Markdown simplu
  coverImage  String
  author      String    @default("Dostore Carti")
  tags        String[]
  // Articolele nepublicate se văd doar în admin (ciornă).
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

/**
 * Setări scrise de aplicație în timpul rulării (nu de om, în Vercel).
 *
 * Există pentru un caz concret: Telegram schimbă id-ul unui grup când acesta
 * devine supergrup, iar mesajele către id-ul vechi eșuează. Reținerea noului id
 * doar în memoria funcției nu ajută — pe serverless fiecare instanță pornește
 * curată și ar redescoperi eroarea la fiecare comandă. Aici rămâne salvat.
 */
model Setting {
  key       String   @id @map("_id")
  value     String
  updatedAt DateTime @updatedAt
}

/**
 * Coada de notificări („outbox"). Fiecare notificare care TREBUIE să ajungă
 * (Telegram, emailul de comandă nouă către magazin) se scrie mai întâi aici,
 * SINCRON, în aceeași cerere care creează comanda — abia apoi se încearcă
 * trimiterea.
 *
 * De ce: până acum notificările plecau doar „după răspuns" (waitUntil) și
 * eșecul era doar logat. Dacă Telegram răspundea cu eroare (exact ce s-a
 * întâmplat când grupul a devenit supergrup) sau funcția era tăiată înainte să
 * termine, notificarea dispărea fără urmă și nimeni nu afla de comandă. Cu
 * rândul salvat în baza de date, o notificare netrimisă rămâne vizibilă și se
 * reîncearcă singură (la comanda următoare, la deschiderea adminului sau din
 * cron), până când chiar pleacă.
 */
model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  channel   String // "telegram" | "admin-email"
  // Cheie de idempotență (ex. „telegram:new-order:BS-20260823-IYLQW7"): oprește
  // dublurile când aceeași notificare e pusă la coadă de două ori.
  dedupeKey String    @unique
  payload   String // text gata formatat (Telegram) sau JSON (email)
  status    String    @default("PENDING") // PENDING | SENDING | SENT | FAILED
  attempts  Int       @default(0)
  lastError String?
  // Când merită reîncercată. Crește progresiv după fiecare eșec.
  nextTryAt DateTime  @default(now())
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, nextTryAt])
}
